#!/bin/bash -l
#
# HST clean slate — A100 leg, `jax_gpu` x sparse, the STANDARD SLaM DELAUNAY chain, both
# lens-light modes (`slam_delaunay` + `slam_delaunay_light_fixed`), seeds 0-1, SHARING the
# jax_cpu dense chain's `source_lp[1]`. The A100 sibling of
# `../batch_cpu/submit_hst_cleanslate_numba_cpu_sparse_delaunay` (autolens_inference#38), so the
# three Delaunay legs (numba sparse, jax_gpu dense, jax_gpu sparse) start from one stage 1.
#
# The model is the production SLaM Delaunay pipeline (1250 Hilbert vertices, AdaptSplit
# regularization), exactly as the numba Delaunay leg documents it; only the backend differs.
#
#   - `--stages-from hpc_a100_jax_cpu_dense_fp64:source_lp`: stage 1 is LOADED from
#     output/autolens/imaging/hst/slam/slam_base/hpc_a100_jax_cpu_dense_fp64/seed_<n>/
#     (source_lp[1] is parametric, so it is the same model for every variant). A config may
#     not share from itself, which is why the source is the jax_cpu dense chain and not this
#     config's own `slam_base` tree.
#   - Submit this array with `--dependency=after:<the dense Delaunay job>+15`, never to start
#     together with `submit_hst_cleanslate_jax_gpu_sparse_delaunay`: two jobs loading the same
#     completed shared stage at the same moment race on removing its `search_internal/`
#     folder and one dies with FileNotFoundError (412624_0, 2026-10-19).
#   - `hpc/wait_for_stage.sh` is the guard; the stage completed on 2026-10-18, so it returns
#     at once.
#   - Pinned: PYAUTO_LIB_BASE / PYAUTO_RELEASE_PIN = 2026.10.17.1.
#   - `--export-prepared` lands each mode in `<dir>/<variant>/` (`slam_delaunay`,
#     `slam_delaunay_light_fixed`), beside the rectangular leg's `slam_base*` folders.
#
# WALL-BASIS: — one row per cell this submit runs. See ../../scripts/misc/wall/README.md.
#   This submit runs ONE cell, `imaging/slam/hst_delaunay`: stages 2-5 fitted (stage 1
#   loaded), plus a second mass_total[1]. It declares `unmeasured`: no clean-slate A100 rate
#   on this cell's Delaunay stages exists. `steps:` is the chain's FLOOR (128 evals per live
#   point x 725 live points = 92800), not an estimate. No `wall:` is offered. `--time` is a
#   CONTAINMENT, not a derived budget. The first arm IS the probe: read `source_pix[1]`'s
#   `wall_s / likelihood_evals` from its row.
#   cell: imaging/slam/hst_delaunay  device: a100  precision: fp64
#   lanes: 1  steps: 92800  source: unmeasured  probe-first: yes
#
#SBATCH -J hst_cleanslate_jax_gpu_sparse_delaunay
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96gb
#SBATCH --time=24:00:00
#SBATCH --array=0-1
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/inference/autolens_inference

# The release pin: exported BEFORE activate.sh, which reads PYAUTO_LIB_BASE.
export PYAUTO_LIB_BASE=/mnt/ral/jnightin/inference/pins/2026.10.17.1
export PYAUTO_RELEASE_PIN=2026.10.17.1
source $AP_ROOT/activate.sh

# JAX_PLATFORMS and JAX_ENABLE_X64 are exported EXPLICITLY, never inherited: without the
# first, this job can silently fall back to CPU and report a "GPU" wall clock that is
# nothing of the kind; without the second, an fp64 config runs in fp32. The driver also
# asserts jax.default_backend() == "gpu" and exits 2 rather than fall back silently.
export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True

# NPROC throttles JAX's CPU thread pool. Unset, this job takes the whole node.
export NPROC=$SLURM_CPUS_PER_TASK

# Proof of what the job actually got. A four-second CUDA init failure and a healthy run
# look identical in sacct; they do not look identical here.
nvidia-smi

SHARED_SEED_DIR=$AP_ROOT/output/autolens/imaging/hst/slam/slam_base/hpc_a100_jax_cpu_dense_fp64/seed_$SLURM_ARRAY_TASK_ID

echo "=========================================="
date
echo "Cell:       imaging/slam/hst_delaunay"
echo "Instrument: hst"
echo "Config:     hpc_a100_jax_gpu_sparse_fp64"
echo "Light:      both (slam_delaunay + slam_delaunay_light_fixed)"
echo "Shared:     source_lp[1] from hpc_a100_jax_cpu_dense_fp64 ($SHARED_SEED_DIR)"
echo "Pin:        $PYAUTO_RELEASE_PIN ($PYAUTO_LIB_BASE)"
echo "Seed:       $SLURM_ARRAY_TASK_ID"

cd $AP_ROOT

bash hpc/wait_for_stage.sh "$SHARED_SEED_DIR" source_lp 300 28800

python3 scripts/imaging/delaunay/validation/baseline_slam.py \
    --instrument hst \
    --backend jax_gpu \
    --inversion sparse \
    --mesh-pixels 1250 \
    --seed $SLURM_ARRAY_TASK_ID \
    --config-name hpc_a100_jax_gpu_sparse_fp64 \
    --lens-light both \
    --stages-from hpc_a100_jax_cpu_dense_fp64:source_lp \
    --export-prepared output/autolens/prepared/hpc_a100_jax_gpu_sparse_fp64/seed_$SLURM_ARRAY_TASK_ID \
    --cores $SLURM_CPUS_PER_TASK

echo "Finished."
date

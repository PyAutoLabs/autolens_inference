#!/bin/bash -l
#
# Likelihood-lifecycle phase 4 (autolens_inference#51): a wall-time validation gap leg.
# `multi_galaxy/delaunay/hst` under the Optimal GPU setup `jax_gpu_dense_fp64`
# (`hpc_a100_jax_gpu_dense_fp64`), seed(s) 0, 1 as the array, model variant(s) default,
# light_fixed (`--lens-light both`). The full chain of
# `scripts/multi_galaxy/delaunay/validation/hst_slam.py` (source_lp[1] -> source_pix[1] ->
# source_pix[2] -> light[1] -> mass_total[1]), every stage fitted here.
#
# GENERATED by scripts/misc/campaigns/validation_p4.py --write; edit the generator, not this
# file (scripts/misc/test/test_validation_p4.py fails on a hand edit). A run needs the human's
# go.
#
# LIBRARIES. The day-zero tag 2026.10.25.1. PYAUTO_LIB_BASE is the private checkout of the
# five libraries at that tag, /mnt/ral/jnightin/profiling/PyAuto_2026.10.25.1, in the layout
# activate.sh expects of a pin directory, so only PYTHONPATH moves (hpc/README.md, "Running
# against a pinned release"). The job refuses to run (exit 5) if a checkout there is not at
# the tag.
#
# OUTPUT. This leg's own PyAutoFit output root,
# `output/p4_validation/validation_multi_galaxy_delaunay_hst_jax_gpu_dense/`: the output path
# omits the pin and the core count, so the shared tree would resume another run's fit.
#
# WALL-BASIS: — one row per cell this submit runs. See ../../scripts/misc/wall/README.md.
#   This submit runs ONE cell, `multi_galaxy/delaunay/validation/hst_slam`. This likelihood
#   has no adopted row, so per stage the evaluations are its declared basis (EVALS_BASIS: a
#   measured count or a declared ceiling, named below), priced at Pulse's per-call time of one
#   batched JAX evaluation (catalogue/pulse_lens_runtime_reference.json). No adopted row
#   measured this cell on this device, so the row is `unmeasured` and the first arm IS the
#   probe: read each stage's `wall_s / likelihood_evals` from its row.
#   - default source_lp[1] = 92550 evals (proxy: max adopted imaging
#     imaging/rectangular/hst/default/jax_gpu_sparse_fp64/hpc_a100/nautilus:source_lp[1]/seed_0);
#     derived 2823 s (lifecycle/5a510cca4fff0c0d5b58)
#   - default source_pix[1] = 53920 evals (proxy: max adopted imaging
#     imaging/delaunay/hst/default/numba_cpu_sparse_fp64/hpc_ral_cpu/nautilus:source_pix[1]/seed_1);
#     derived 1644 s (lifecycle/5a510cca4fff0c0d5b58)
#   - default source_pix[2] = 9460 evals (proxy: max adopted imaging
#     imaging/rectangular/hst/default/numba_cpu_sparse_fp64/hpc_ral_cpu/nautilus:source_pix[2]/seed_1);
#     derived 289 s (lifecycle/5a510cca4fff0c0d5b58)
#   - default light[1] = 12000 evals (proxy: max adopted imaging
#     imaging/rectangular/hst/default/numba_cpu_sparse_fp64/hpc_ral_cpu/nautilus:light[1]/seed_1);
#     derived 366 s (lifecycle/5a510cca4fff0c0d5b58)
#   - default mass_total[1] = 38660 evals (proxy: max adopted imaging
#     imaging/delaunay/hst/default/numba_cpu_sparse_fp64/hpc_ral_cpu/nautilus:mass_total[1]/seed_1);
#     derived 1179 s (lifecycle/5a510cca4fff0c0d5b58)
#   - light_fixed mass_total[1] = 38660 evals (proxy: max adopted imaging
#     imaging/delaunay/hst/default/numba_cpu_sparse_fp64/hpc_ral_cpu/nautilus:mass_total[1]/seed_1);
#     derived 1179 s (lifecycle/5a510cca4fff0c0d5b58)
#   The estimate is 7480 s (2.1 h); --time clears 3x of it.
#   cell: multi_galaxy/delaunay/validation/hst_slam  device: a100  precision: fp64
#   lanes: 1  steps: 245250  source: unmeasured  probe-first: yes  wall: 7480
#
#SBATCH -J p4_validation_multi_galaxy_delaunay_hst_jax_gpu_dense
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96gb
#SBATCH --time=12:00:00
#SBATCH --array=0-1
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/inference/autolens_inference

# The release pin: exported BEFORE activate.sh, which reads PYAUTO_LIB_BASE.
export PYAUTO_LIB_BASE=/mnt/ral/jnightin/profiling/PyAuto_2026.10.25.1
export PYAUTO_RELEASE_PIN=2026.10.25.1
source $AP_ROOT/activate.sh

for repo in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    tag=$(git -C "$PYAUTO_LIB_BASE/$repo" describe --tags --exact-match HEAD 2>/dev/null || echo none)
    if [ "$tag" != "$PYAUTO_RELEASE_PIN" ]; then
        echo "ERROR: $PYAUTO_LIB_BASE/$repo is at $tag, not $PYAUTO_RELEASE_PIN. Refusing to run." >&2
        exit 5
    fi
done

# JAX_PLATFORMS and JAX_ENABLE_X64 are exported EXPLICITLY: without the first this job can
# silently fall back to CPU and report a "GPU" wall clock; without the second an fp64 config
# runs in fp32. The driver also asserts jax.default_backend() == "gpu" and exits 2.
export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True

# NPROC throttles JAX's CPU thread pool. Unset, this job takes the whole node.
export NPROC=$SLURM_CPUS_PER_TASK

# Proof of what the job actually got.
nvidia-smi

SEED=$SLURM_ARRAY_TASK_ID
OUTPUT_ROOT=$AP_ROOT/output/p4_validation/validation_multi_galaxy_delaunay_hst_jax_gpu_dense

echo "=========================================="
date
echo "Cell:       multi_galaxy/delaunay/validation/hst_slam"
echo "Instrument: hst"
echo "Config:     hpc_a100_jax_gpu_dense_fp64"
echo "Light:      both (default, light_fixed)"
echo "Pin:        $PYAUTO_RELEASE_PIN ($PYAUTO_LIB_BASE)"
echo "Output:     $OUTPUT_ROOT"
echo "Seed:       $SEED"

cd $AP_ROOT

python3 scripts/multi_galaxy/delaunay/validation/hst_slam.py \
    --instrument hst \
    --backend jax_gpu \
    --inversion dense \
    --seed $SEED \
    --config-name hpc_a100_jax_gpu_dense_fp64 \
    --lens-light both \
    --output-dir $OUTPUT_ROOT \
    --cores $SLURM_CPUS_PER_TASK

echo "Finished."
date

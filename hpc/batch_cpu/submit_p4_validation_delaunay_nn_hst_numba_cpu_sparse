#!/bin/bash -l
#
# Likelihood-lifecycle phase 4 (autolens_inference#51): a wall-time validation gap leg.
# `imaging/delaunay_nn/hst` under the Optimal CPU setup `numba_cpu_sparse_fp64`
# (`hpc_ral_numba_cpu_sparse_fp64`), seed(s) 0, 1 as the array, model variant(s) default,
# light_fixed (`--lens-light both`). The full SLaM chain, with `source_lp[1]` loaded from
# `hpc_a100_jax_cpu_dense_fp64` (`--stages-from`).
#
# GENERATED by scripts/misc/campaigns/validation_p4.py --write; edit the generator, not this
# file (scripts/misc/test/test_validation_p4.py fails on a hand edit). A run needs the human's
# go.
#
# `--partition=ral` ONLY. CPU jobs never go on `gpu`. There is NO `cpu` partition on RAL.
#
# LIBRARIES. The day-zero tag 2026.10.25.1. PYAUTO_LIB_BASE is the private checkout of the
# five libraries at that tag, /mnt/ral/jnightin/profiling/PyAuto_2026.10.25.1, in the layout
# activate.sh expects of a pin directory, so only PYTHONPATH moves (hpc/README.md, "Running
# against a pinned release"). The job refuses to run (exit 5) if a checkout there is not at
# the tag.
#
# OUTPUT. This leg's own PyAutoFit output root,
# `output/p4_validation/validation_delaunay_nn_hst_numba_cpu_sparse/`: the output path omits
# the pin and the core count, so the shared tree would resume another run's fit.
# `--stages-from` resolves the loaded stage under that root, so the job waits for the
# `hpc_a100_jax_cpu_dense_fp64` chain's `source_lp[1]` and copies it in once; the leg then
# loads its own copy and never races another job on one stage's `search_internal/`. If the
# day-zero libraries hash the copy to another identifier, the runner exits 3.
#
# WALL-BASIS: — one row per cell this submit runs. See ../../scripts/misc/wall/README.md.
#   This submit runs ONE cell, `imaging/slam/hst_delaunay_nn`. Per stage, the evaluations are
#   the most any adopted row of this likelihood and model variant took, priced at Pulse's
#   single-thread per-call time over 8 Nautilus worker(s)
#   (catalogue/pulse_lens_runtime_reference.json). This likelihood has no adopted row, so the
#   evaluations are counted on the adopted `imaging/delaunay` rows, the same chain on the same
#   data. No adopted row measured this cell on this device, so the row is `unmeasured` and the
#   first arm IS the probe: read each stage's `wall_s / likelihood_evals` from its row.
#   - default source_pix[1] = 53920 evals
#     (imaging/delaunay/hst/default/numba_cpu_sparse_fp64/hpc_ral_cpu/nautilus:source_pix[1]/seed_1);
#     derived 8727 s (lifecycle/05dde64a0eb7fdd0c4a1)
#   - default source_pix[2] = 2120 evals
#     (imaging/delaunay/hst/default/numba_cpu_sparse_fp64/hpc_ral_cpu/nautilus:source_pix[2]/seed_1);
#     derived 343 s (lifecycle/05dde64a0eb7fdd0c4a1)
#   - default light[1] = 10180 evals
#     (imaging/delaunay/hst/default/numba_cpu_sparse_fp64/hpc_ral_cpu/nautilus:light[1]/seed_1);
#     derived 1648 s (lifecycle/05dde64a0eb7fdd0c4a1)
#   - default mass_total[1] = 38660 evals
#     (imaging/delaunay/hst/default/numba_cpu_sparse_fp64/hpc_ral_cpu/nautilus:mass_total[1]/seed_1);
#     derived 6257 s (lifecycle/05dde64a0eb7fdd0c4a1)
#   - light_fixed mass_total[1] = 34060 evals
#     (imaging/delaunay/hst/light_fixed/numba_cpu_sparse_fp64/hpc_ral_cpu/nautilus:mass_total[1]/seed_1);
#     derived 5513 s (lifecycle/05dde64a0eb7fdd0c4a1)
#   The estimate is 22488 s (6.2 h); --time clears 3x of it.
#   cell: imaging/slam/hst_delaunay_nn  device: ral_numba_cpu  precision: fp64
#   lanes: 1  steps: 138940  source: unmeasured  probe-first: yes  wall: 22488
#
#SBATCH -J p4_validation_delaunay_nn_hst_numba_cpu_sparse
#SBATCH --partition=ral
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96gb
#SBATCH --time=1-00:00:00
#SBATCH --array=0-1
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/inference/autolens_inference

# The release pin: exported BEFORE activate.sh, which reads PYAUTO_LIB_BASE.
export PYAUTO_LIB_BASE=/mnt/ral/jnightin/profiling/PyAuto_2026.10.25.1
export PYAUTO_RELEASE_PIN=2026.10.25.1
source $AP_ROOT/activate.sh

for repo in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    tag=$(git -C "$PYAUTO_LIB_BASE/$repo" describe --tags --exact-match HEAD 2>/dev/null || echo none)
    if [ "$tag" != "$PYAUTO_RELEASE_PIN" ]; then
        echo "ERROR: $PYAUTO_LIB_BASE/$repo is at $tag, not $PYAUTO_RELEASE_PIN. Refusing to run." >&2
        exit 5
    fi
done

export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=True

# NPROC throttles JAX's CPU thread pool. Unset, this job takes the whole node.
export NPROC=$SLURM_CPUS_PER_TASK

# PYAUTO_DISABLE_JAX is the process-wide belt to use_jax=False's braces.
export PYAUTO_DISABLE_JAX=1

# One BLAS / OpenMP thread per process (autolens_inference#38): Nautilus forks
# --cores workers, and unpinned pools oversubscribe the node. Exported before
# python3, because numpy/scipy read them at import.
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

SEED=$SLURM_ARRAY_TASK_ID
OUTPUT_ROOT=$AP_ROOT/output/p4_validation/validation_delaunay_nn_hst_numba_cpu_sparse
SHARED_SEED_DIR=$AP_ROOT/output/autolens/imaging/hst/slam/slam_base/hpc_a100_jax_cpu_dense_fp64/seed_$SEED
LOCAL_SHARED_DIR=$OUTPUT_ROOT/autolens/imaging/hst/slam/slam_base/hpc_a100_jax_cpu_dense_fp64/seed_$SEED

echo "=========================================="
date
echo "Cell:       imaging/slam/hst_delaunay_nn"
echo "Instrument: hst"
echo "Config:     hpc_ral_numba_cpu_sparse_fp64"
echo "Light:      both (default, light_fixed)"
echo "Shared:     source_lp[1] from hpc_a100_jax_cpu_dense_fp64 ($SHARED_SEED_DIR)"
echo "Pin:        $PYAUTO_RELEASE_PIN ($PYAUTO_LIB_BASE)"
echo "Output:     $OUTPUT_ROOT"
echo "Seed:       $SEED"

cd $AP_ROOT

# In-job wait: 5-minute polls, 8 h cap, exit 4 on timeout. Then this leg's own copy.
bash hpc/wait_for_stage.sh "$SHARED_SEED_DIR" source_lp 300 28800
if [ ! -d "$LOCAL_SHARED_DIR/source_lp[1]" ]; then
    mkdir -p "$LOCAL_SHARED_DIR"
    cp -r "$SHARED_SEED_DIR/source_lp[1]" "$LOCAL_SHARED_DIR/"
fi

python3 scripts/imaging/delaunay_nn/validation/baseline_slam.py \
    --instrument hst \
    --backend numba_cpu \
    --inversion sparse \
    --seed $SEED \
    --config-name hpc_ral_numba_cpu_sparse_fp64 \
    --lens-light both \
    --stages-from hpc_a100_jax_cpu_dense_fp64:source_lp \
    --output-dir $OUTPUT_ROOT \
    --export-prepared output/p4_validation/validation_delaunay_nn_hst_numba_cpu_sparse/prepared/seed_$SEED \
    --cores $SLURM_CPUS_PER_TASK

echo "Finished."
date

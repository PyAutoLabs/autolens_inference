#!/bin/bash -l
#
# Likelihood-lifecycle phase 4 (autolens_inference#51): a wall-time validation gap leg.
# `cluster/source_plane/simple` under the Optimal CPU setup `jax_cpu_na_fp64`
# (`hpc_ral_jax_cpu_na_fp64`), seed(s) 0, 1 as the array, model variant(s) default. The full
# chain of `scripts/cluster/source_plane/validation/modeling.py` (modeling[1]), every stage
# fitted here.
#
# GENERATED by scripts/misc/campaigns/validation_p4.py --write; edit the generator, not this
# file (scripts/misc/test/test_validation_p4.py fails on a hand edit). A run needs the human's
# go.
#
# `--partition=ral` ONLY. CPU jobs never go on `gpu`. There is NO `cpu` partition on RAL.
#
# LIBRARIES. The day-zero tag 2026.10.25.1. PYAUTO_LIB_BASE is the private checkout of the
# five libraries at that tag, /mnt/ral/jnightin/profiling/PyAuto_2026.10.25.1, in the layout
# activate.sh expects of a pin directory, so only PYTHONPATH moves (hpc/README.md, "Running
# against a pinned release"). The job refuses to run (exit 5) if a checkout there is not at
# the tag.
#
# OUTPUT. This leg's own PyAutoFit output root,
# `output/p4_validation/validation_cluster_source_plane_simple_jax_cpu_na/`: the output path
# omits the pin and the core count, so the shared tree would resume another run's fit.
#
# WALL-BASIS: — one row per cell this submit runs. See ../../scripts/misc/wall/README.md.
#   This submit runs ONE cell, `cluster/search/simple_source_plane`. This likelihood has no
#   adopted row, so per stage the evaluations are its declared basis (EVALS_BASIS: a measured
#   count or a declared ceiling, named below), priced at Pulse's per-call time of one batched
#   JAX evaluation (catalogue/pulse_lens_runtime_reference.json). No adopted row measured this
#   cell on this device, so the row is `unmeasured` and the first arm IS the probe: read each
#   stage's `wall_s / likelihood_evals` from its row.
#   - default modeling[1] = 200000 evals (declared-ceiling-4c3-unmeasured); derived 49 s
#     (lifecycle/004001caf29a727421e0)
#   The estimate is 50 s (0.0 h); --time clears 3x of it.
#   cell: cluster/search/simple_source_plane  device: ral_jax_cpu  precision: fp64
#   lanes: 1  steps: 200000  source: unmeasured  probe-first: yes  wall: 50
#
#SBATCH -J p4_validation_cluster_source_plane_simple_jax_cpu_na
#SBATCH --partition=ral
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16gb
#SBATCH --time=06:00:00
#SBATCH --array=0-1
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/inference/autolens_inference

# The release pin: exported BEFORE activate.sh, which reads PYAUTO_LIB_BASE.
export PYAUTO_LIB_BASE=/mnt/ral/jnightin/profiling/PyAuto_2026.10.25.1
export PYAUTO_RELEASE_PIN=2026.10.25.1
source $AP_ROOT/activate.sh

for repo in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    tag=$(git -C "$PYAUTO_LIB_BASE/$repo" describe --tags --exact-match HEAD 2>/dev/null || echo none)
    if [ "$tag" != "$PYAUTO_RELEASE_PIN" ]; then
        echo "ERROR: $PYAUTO_LIB_BASE/$repo is at $tag, not $PYAUTO_RELEASE_PIN. Refusing to run." >&2
        exit 5
    fi
done

export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=True

# NPROC throttles JAX's CPU thread pool. Unset, this job takes the whole node.
export NPROC=$SLURM_CPUS_PER_TASK

SEED=$SLURM_ARRAY_TASK_ID
OUTPUT_ROOT=$AP_ROOT/output/p4_validation/validation_cluster_source_plane_simple_jax_cpu_na

echo "=========================================="
date
echo "Cell:       cluster/search/simple_source_plane"
echo "Instrument: simple"
echo "Config:     hpc_ral_jax_cpu_na_fp64"
echo "Pin:        $PYAUTO_RELEASE_PIN ($PYAUTO_LIB_BASE)"
echo "Output:     $OUTPUT_ROOT"
echo "Seed:       $SEED"

cd $AP_ROOT

python3 scripts/cluster/source_plane/validation/modeling.py \
    --instrument simple \
    --backend jax_cpu \
    --inversion na \
    --seed $SEED \
    --config-name hpc_ral_jax_cpu_na_fp64 \
    --output-dir $OUTPUT_ROOT \
    --cores $SLURM_CPUS_PER_TASK

echo "Finished."
date

#!/bin/bash -l
#
# HST clean slate, phase 3 wave 1 — the four samplers on the frozen RAL CPU `jax_cpu` dense
# mass_total[1] problems, both lens-light modes, sampler seeds 0-2: 24 arms on the RAL CPU nodes.
#
# `--partition=ral` ONLY. CPU arrays never go on `gpu` (nor `ral,gpu` / `gpu,ral`): bulk CPU
# jobs there starve the A100s. There is NO `cpu` partition on RAL.
#
# PyAutoInsight campaign `hst-imaging-mass-samplers`, task `hst_mass_samplers_wave1`
# (autolens_inference#27). The same 24 arms as
# ../batch_gpu/submit_hst_cleanslate_mass_samplers_jax_gpu_dense, on the problems phase 2's
# `submit_hst_cleanslate_jax_cpu_dense` exports to
# output/prepared/cleanslate_2026_10_17/hpc_a100_jax_cpu_dense_fp64/seed_<n>/<variant>/.
# NOT SUBMITTED with the GPU wave: the CPU base chains take days, and this array waits for their
# rows. Submit it only with a dependency on that base array:
#
#   hpc/sync submit --cpu --dependency afterok:<base job id> submit_hst_cleanslate_mass_samplers_jax_cpu_dense
#
# The arm table is data in scripts/misc/experiments/wave.py (wave `cleanslate_2026_10_17_wave1`);
# `wave.py --list --config hpc_a100_jax_cpu_dense_fp64` prints the 24 arms and their run ids,
# `--account` reports each as row / failed / missing. Each arm reads its problem id from the
# manifest at run time; the leaf refuses any identity, digest or library-revision mismatch and
# any existing run id.
#
# Sampler filter (autolens_inference#33): NUTS and SMC are DEFERRED in wave 1 after the A100
# OOM (wave.py DEFERRED), so this array runs the twelve Nautilus and Emcee arms
# (`PYAUTO_WAVE_SAMPLERS`, default nautilus,emcee; array index = position in that filtered
# list, `--array=0-11%6`), attempt `PYAUTO_WAVE_ATTEMPT` (default 1: the CPU wave never ran).
#
# Pinned like the base it reads: the 2026.10.17.1 pin (hpc/README.md "Running against a pinned
# release").
#
# WALL-BASIS: — one row per cell this submit runs. See ../../scripts/misc/wall/README.md.
#   Four cells, one per sampler leaf, nothing measured on any of them on a RAL CPU node. No
#   `wall:` is offered; `--time` below is a CONTAINMENT, not a derived budget, and the `%6`
#   throttle makes the first arm of each sampler its probe: read `total_wall_s` from its row.
#   cell: imaging/rectangular/nautilus  device: ral_jax_cpu  precision: fp64
#   lanes: 1  steps: unmeasured  source: unmeasured  probe-first: yes
#   cell: imaging/rectangular/emcee  device: ral_jax_cpu  precision: fp64
#   lanes: 1  steps: 2000  source: unmeasured  probe-first: yes
#   cell: imaging/rectangular/nuts  device: ral_jax_cpu  precision: fp64
#   lanes: 1  steps: 1500  source: unmeasured  probe-first: yes
#   cell: imaging/rectangular/smc  device: ral_jax_cpu  precision: fp64
#   lanes: 1  steps: 1000  source: unmeasured  probe-first: yes
#
#SBATCH -J hst_cs_mass_samplers_jax_cpu_dense
#SBATCH --partition=ral
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64gb
#SBATCH --time=24:00:00
#SBATCH --array=0-11%6
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/inference/autolens_inference

# The release pin: exported BEFORE activate.sh, which reads PYAUTO_LIB_BASE.
export PYAUTO_LIB_BASE=/mnt/ral/jnightin/inference/pins/2026.10.17.1
export PYAUTO_RELEASE_PIN=2026.10.17.1
source $AP_ROOT/activate.sh

export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=True

# NPROC throttles JAX's CPU thread pool. Unset, this job takes the whole node.
export NPROC=$SLURM_CPUS_PER_TASK

cd $AP_ROOT

CONFIG=hpc_a100_jax_cpu_dense_fp64
BASE_SEED=0
HARDWARE_ID=ral-cpu-8cpu
# The sampler order of wave.py's arm table; wave.py refuses the arm if this ever differs.
SAMPLERS=(nautilus emcee nuts smc)
WAVE=scripts/misc/experiments/wave.py
# Attempt and sampler filter (autolens_inference#33). The array index is a position in the
# FILTERED arm list (wave order), so `--array` must be 0-<n-1> for the filter's n arms
# (`wave.py --list --config $CONFIG --sampler-filter ...` prints them). NUTS and SMC are
# deferred in wave 1 (A100 OOM, wave.py DEFERRED) and refused if selected.
ATTEMPT=${PYAUTO_WAVE_ATTEMPT:-1}
WAVE_SAMPLERS=${PYAUTO_WAVE_SAMPLERS:-nautilus,emcee}
ARM_FLAGS="--arm $SLURM_ARRAY_TASK_ID --config $CONFIG --base-seed $BASE_SEED --attempt $ATTEMPT --sampler-filter $WAVE_SAMPLERS"

SAMPLER_INDEX=$(python3 $WAVE $ARM_FLAGS --samplers "${SAMPLERS[*]}" --field sampler_index)
SAMPLER=${SAMPLERS[$SAMPLER_INDEX]}
LEAF_ARGS=$(python3 $WAVE $ARM_FLAGS --hardware-id $HARDWARE_ID --cores $SLURM_CPUS_PER_TASK --print-args)

echo "=========================================="
date
ARM_INDEX=$(python3 $WAVE $ARM_FLAGS --field index)
echo "Wave:       cleanslate_2026_10_17_wave1, attempt $ATTEMPT, samplers $WAVE_SAMPLERS, array index $SLURM_ARRAY_TASK_ID = arm $ARM_INDEX"
echo "Cell:       imaging/rectangular/$SAMPLER"
echo "Config:     $CONFIG (problem base seed $BASE_SEED)"
echo "Pin:        $PYAUTO_RELEASE_PIN ($PYAUTO_LIB_BASE)"
echo "Leaf args:  $LEAF_ARGS"

python3 scripts/imaging/rectangular/${SAMPLER}.py $LEAF_ARGS

echo "Finished."
date

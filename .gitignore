__pycache__/
*.pyc
root.log
*.log
.codex/

# PyAutoFit run output. Unlike autolens_profiling this repo KEEPS its output on disk
# (config/general.yaml sets hpc_mode: false and remove_files: false) — a posterior, its
# samples and its convergence history are the evidence, not a single number. It is still
# never committed: budget ~150 MB per 5-stage lens per leg. The committed artifact is the
# small result row under results/.
output/

# Cortex pull state written by `hpc/sync pull` — a manifest of RAL-side checkpoints, not
# science.
.cortex/

# Generated artifacts — never check in
image.fits
path/
output_path/

# Profiler artifacts
*.prof
*.pstats

# JAX / numba / matplotlib caches (when not redirected via env vars)
.jax_cache/
__jax_cache__/
.numba_cache/
.mplconfig/

# Tool caches
.pytest_cache/
.ruff_cache/

# hpc/sync's local HPC configuration (host, base path, pull destination). Machine-
# specific; hpc/sync.conf.example is the tracked template.
hpc/sync.conf

# SLURM stdout/stderr, written beside the submit scripts because that is where SLURM
# puts them. Bulk log output, pulled to the laptop by `hpc/sync logs`; the directories
# themselves are tracked via .gitkeep so a fresh clone can submit without mkdir.
hpc/batch_gpu/output/*
hpc/batch_gpu/error/*
hpc/batch_cpu/output/*
hpc/batch_cpu/error/*
!hpc/batch_gpu/output/.gitkeep
!hpc/batch_gpu/error/.gitkeep
!hpc/batch_cpu/output/.gitkeep
!hpc/batch_cpu/error/.gitkeep
# `hpc/sync pull` lands SLURM logs here (logs/{gpu,cpu}/{output,error}); never tracked.
logs/

# Local virtualenvs
.venv/
venv/

# Auto-simulated input datasets — regenerated by the simulator scripts, not committed.
# `_inference_cli.auto_simulate_if_missing` re-runs scripts/misc/simulators/<type>.py on
# demand, so a missing dataset costs a few minutes of CPU, not a lost run. They are kept
# out of git because they are large binary FITS that every machine would otherwise fight
# over, and because a dataset that regenerates is an input, not a result.
#
# The caveat that matters: a dataset that does NOT regenerate byte-identically must be
# tracked instead, and removed from this list with a comment saying why. Verify a new
# instrument by moving its directory aside and re-running its simulator — not by `cmp`
# alone, since a FITS header stamp can differ while the pixel data is identical.
dataset/imaging/
dataset/interferometer/
dataset/point_source/

# Lensed-source adapt images — produced by the simulators and cached on demand beside the
# dataset. Regeneratable from tracer.json on first run; kept out of git so different
# machines don't fight over a file that is purely an auto-cache.
dataset/**/lensed_source.fits
